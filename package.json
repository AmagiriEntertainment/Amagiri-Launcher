{
  "name": "amagiri-launcher",
  "version": "1.0.0",
  "description": "Amagiri Launcher - Minecraft launcher by Amagiri Entertainment",
  "main": "./out/main/index.js",
  "author": "Amagiri Entertainment",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.4",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.4.2",
    "framer-motion": "^11.11.17"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.amagiri.launcher",
    "productName": "Amagiri Launcher",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build-icon.ico"
    }
  }
}
